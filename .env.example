# Copie para .env e preencha. O .env nao vai pro git (ver .gitignore).
# Ou rode .\instalar.ps1, que cria este arquivo e acha o gbak sozinho.

# ── ORIGEM: backups .FBK do AtecSoft ────────────────────────────────────────
# Aponte para a PASTA de backup (nao para o arquivo): o script pega o .FBK mais
# recente dela. Uma das fontes gera nome com data, entao arquivo fixo pararia de
# ser achado no dia seguinte.
#
# Lemos do backup, e nao do servidor Firebird, porque o Firebird do DC001 sobe
# junto com o AtecSoft (usado a tarde) e fica fora do ar o resto do tempo. O
# gbak restaura o .FBK e, de brinde, converte o ODS 10 (Firebird 1.x) que as
# bibliotecas atuais nao abririam direto.
#
# O numero N vira a coluna ID_FONTE (empresa) — e o que distingue a mesma pessoa
# cadastrada em empresas diferentes.
FB_FBK_1=\\10.48.12.2\Ponto AtecSoft Novo Ant Con\DADOS\BACKUP
FB_FBK_2=\\10.48.12.2\Ponto AtecSoft_altarneiro\DADOS\BACKUP
FB_FBK_3=\\10.48.12.2\Ponto AtecSoft\DADOS\BACKUP

# Credencial das bases restauradas (o gbak recria com estas).
FB_USER=SYSDBA
FB_PASS=

# gbak.exe — o instalar.ps1 preenche isto sozinho.
GBAK_EXE=gbak

# Avisa no log se o backup estiver mais velho que isso (ninguem abriu o AtecSoft).
MAX_IDADE_BACKUP_H=48

# ── DESTINO: MariaDB (dbDrogamaisRH, o banco que o app do RH le) ────────────
MARIA_USER=
MARIA_PASS=
MARIA_HOST=10.48.12.20
MARIA_PORT=3306
MARIA_DB=dbDrogamaisRH

# ── RELOGIOS: captura do AFD que enriquece a staging ────────────────────────
# O AtecSoft nao tem as batidas que ficaram so no relogio, entao baixamos o AFD
# e preenchemos a _stg ANTES do swap.
#
# O Henry do CD fica de fora de proposito: ele aceita UMA sessao por vez e quem
# cobre esse aparelho e o agente coletor (repo agentes-rh). Dois coletores no
# mesmo Henry se bloqueiam.
CONTROLID_URLS=https://192.168.21.249,https://192.168.21.248
CONTROLID_USER=admin
CONTROLID_PASS=
HENRY_URLS=
HENRY_USER=rep
HENRY_PASS=

# Janela de dias do AFD a considerar.
JANELA_DIAS=30

# ── Tabelas ────────────────────────────────────────────────────────────────
# Viram a camada silver (dim_atec_*/fat_atec_*). A bronze (fb_*) tem lista
# propria, fixa no script.
TABELAS_ALVO=BH,CP,CP_T,FERIADO,FUNCIONARIO,LOG,JUSTFICATIVA

# Linhas por lote na gravacao. A CP (75k x 116 colunas) estoura o
# max_allowed_packet num INSERT unico ("Server has gone away").
PONTO_LOTE_LINHAS=5000
